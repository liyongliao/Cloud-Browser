# DNS hostname pointed at your Linux x86_64 server; no scheme or path.
DOMAIN=browser.example.com
# Generate URL-safe hex: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-random-hex-password
DATABASE_MODE=internal
COMPOSE_PROFILES=database
MAX_SESSIONS=3
# Optional: reuse an existing host HTTPS reverse proxy.
# GATEWAY_SITE=:80
# GATEWAY_HTTP_BIND=127.0.0.1:18088
# GATEWAY_HTTPS_BIND=127.0.0.1:18443
